{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/scraper/cron?mode=full",
      "schedule": "0 */6 * * *"
    }
  ],
  "functions": {
    "src/app/api/ai/**/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/scraper/**/route.ts": {
      "maxDuration": 60
    }
  }
}
